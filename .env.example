# 复制为 .env，填写你自己的兼容 OpenAI Chat Completions / tools 接口。
# BASE_URL 包含 /v1 等服务商要求的前缀，不包含 /chat/completions。
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_STEPS=12
# auto: 优先原生 tools，接口仅返回正文时自动兼容结构化 JSON 工具计划。
# structured: 直接使用 JSON 工具计划；native: 仅使用原生 tools。
LLM_TOOL_MODE=auto

DATABASE_PATH=data/banking.sqlite3

# 默认关闭。只有需要接通真实飞书时才填写这些值。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 本地桥接进程访问后端的随机长密钥，不是飞书密钥。
FEISHU_BRIDGE_TOKEN=
BACKEND_URL=http://127.0.0.1:8000
