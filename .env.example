# 复制为 .env，填写你自己的兼容 OpenAI Chat Completions / tools 接口。
# BASE_URL 包含 /v1 等服务商要求的前缀，不包含 /chat/completions。
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_STEPS=12
# auto: 优先原生 tools，接口仅返回正文时自动兼容结构化 JSON 工具计划。
# structured: 直接使用 JSON 工具计划；native: 仅使用原生 tools。
LLM_TOOL_MODE=auto

DATABASE_PATH=data/banking.sqlite3

# 默认关闭。只有需要接通真实飞书时才填写这些值。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 本地桥接进程访问后端的随机长密钥，不是飞书密钥。
FEISHU_BRIDGE_TOKEN=
# 手机飞书打开专用支付页所用的 HTTPS 根地址；留空仅供本机测试。
FEISHU_PUBLIC_URL=
BACKEND_URL=http://127.0.0.1:8000

# 审计签名凭据由管理员进程管理，生产应指定独立权限或异机存储
AUDIT_WITNESS_ENABLED=true
# AUDIT_WITNESS_PATH=C:/secure/youshu-audit-witness

# 可选：本地语音模型目录，默认项目下 data/speech；先运行 python scripts/setup_speech.py
# SPEECH_MODEL_DIR=C:/path/to/AI-banking-main/data/speech

# 人脸验证总开关，修改后重启后端。关闭后黄色使用密码，红色仍需密码和短信。
FACE_ENABLED=true
# FACE_MODEL_DIR=C:/path/to/AI-banking-main/data/face
